<% content_for :title, "一覧" %>

<div class="page-head">
  <div>
    <h1>本の一覧</h1>
    <p class="page-head__sub">登録件数：<strong><%= @books.size %></strong>件</p>
  </div>
  <%= link_to "＋ 新規登録", new_book_path, class: "btn btn--primary" %>
</div>

<%= form_with url: books_path, method: :get, class: "search", data: { turbo: false } do |f| %>
  <%= f.search_field :q, value: @keyword, placeholder: "タイトル・著者で検索", class: "form__input search__input" %>
  <%= f.submit "検索", name: nil, class: "btn btn--secondary" %>
  <% if @keyword.present? %>
    <%= link_to "クリア", books_path, class: "btn btn--ghost" %>
  <% end %>
<% end %>

<% if @books.any? %>
  <div class="card card--flush">
    <table class="table">
      <thead>
        <tr>
          <th>タイトル</th>
          <th>著者</th>
          <th class="table__num">出版年</th>
          <th class="table__actions">操作</th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td class="table__title"><%= link_to book.title, book_path(book) %></td>
            <td><%= book.author %></td>
            <td class="table__num"><%= book.published_year %></td>
            <td class="table__actions">
              <%= link_to "詳細", book_path(book), class: "btn btn--ghost btn--sm" %>
              <%= link_to "編集", edit_book_path(book), class: "btn btn--secondary btn--sm" %>
              <%= button_to "削除", book_path(book), method: :delete,
                    class: "btn btn--danger btn--sm",
                    form: { class: "inline-form", data: { turbo_confirm: "「#{book.title}」を削除しますか？" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="card empty">
    <% if @keyword.present? %>
      <p>「<%= @keyword %>」に一致する本は見つかりませんでした。</p>
    <% else %>
      <p>まだ本が登録されていません。</p>
      <%= link_to "最初の1冊を登録する", new_book_path, class: "btn btn--primary" %>
    <% end %>
  </div>
<% end %>